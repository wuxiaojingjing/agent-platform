#!/usr/bin/env bash
# 复制为 scripts/env.local.sh 后填入真实值。该文件已在 .gitignore 中，不要提交。
#
# 硅基流动国内站（api.siliconflow.cn）与国际站（api.siliconflow.com）是两套独立账号，
# 密钥不通用；国内站密钥打国际站会返回 Token is invalid。

export SILICONFLOW_API_KEY="sk-替换为你自己的密钥"

# 仲裁与 agent loop（DeepSeek V4 Flash）。embedding 仍用上面的硅基流动密钥。
export DEEPSEEK_API_KEY="sk-替换为你自己的 DeepSeek 密钥"

# 可选：覆盖默认网关地址（默认 https://api.siliconflow.cn/v1）
# export HUAWEI_FINANCE_AGENT_MODEL_BASE_URL="https://api.siliconflow.cn/v1"

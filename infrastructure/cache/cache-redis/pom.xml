<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 infrastructure/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>cache-redis</artifactId>
  <name>cache-redis</name>
  <description>意图引擎出口缓存的 Redis 基线实现。单独成模块，让 intent-fastpath 不必依赖 Redisson</description>

  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <!--
      只依赖门面模块，为的是拿 DecisionCache 这个 @Spi 接口。方向是适配器→契约，不可反向：
      引擎一旦依赖本模块，Redisson 就又回到了每个依赖引擎的 Agent 的 classpath 上，
      而那正是本模块存在的理由（架构草案 §4.3 第 4 行）。

      这里此前写的是 intent-fastpath——一个**适配器**为了实现一个接口，
      把 hanlp、aviator、agent-core-java 全背了进来，而它一个都不用。
      门面拆出 intent-engine-api 之后这条依赖才收得住。
      「api 不拖实现」由 ModuleDependencyTest#intentEngineApiIsDependableAlone 钉住。
    -->
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>intent-engine-api</artifactId>
    </dependency>
    <!-- 直接 import AssetBundle 取 TTL，就直接声明，不吃别人的传递依赖。 -->
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>asset-registry</artifactId>
    </dependency>

    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson</artifactId>
    </dependency>

    <!--
      optional：只为把本模块的 Redis 连接反向注册进 OJ 的 KVStoreFactory（见 ADR-009），
      让 OJ 侧组件与意图引擎共用一套连接配置，而不是各配一份。

      标 optional 而不是普通 compile，是因为 optional 不传递：依赖 cache-redis 的模块
      不会因此被拖进 agent-core-java（裸装 101 个 jar / 162 MB，见 agent-bom 里的说明）。
      注册类本身由 @ConditionalOnClass 守着，OJ 不在 classpath 上时整段装配不生效，
      于是「只要 Redis 缓存、不要 OJ」这种用法仍然成立。
    -->
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-core-java</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

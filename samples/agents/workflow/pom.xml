<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 domains/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>workflow-agent-sample</artifactId>
  <name>workflow-agent-sample</name>
  <description>领域办理流程以 OpenJiuwen 工作流声明：流程编排交给 OJ 图引擎，行内只写声明与结果映射</description>

  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>asset-registry</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-api</artifactId>
    </dependency>
    <!-- RepoLayout：流程声明目录默认值要向上定位仓库 assets/，不写死进程从哪层启动 -->

    <!--
      工作流引擎本体。排除项在 agent-bom 里统一声明（Milvus/Pulsar/POI/PDFBox/SQLite/
      openai-java/logback 等），此处不重复，也不得在此覆写。
    -->
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-core-java</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!--
      只要自动配置与 @ConfigurationProperties，不要 web：领域办理流程既可能跑在
      OJ Agent Server 里，也可能被行内嵌进别的容器，不该由本模块决定要不要起 Servlet。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 声明式流程产出的 DomainAgent 也必须过 TCK：契约不因实现方式而放宽 -->
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-tck</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 测试里要起一个假的下游行内系统，验 HTTP 步骤真的发出去了 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

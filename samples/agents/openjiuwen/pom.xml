<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 domains/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>openjiuwen-agent-sample</artifactId>
  <name>openjiuwen-agent-sample</name>
  <description>OpenJiuwen Agent Server 接入：UnifiedTask 与 /v1/query 的契约编解码、行内 AgentHandler、中控侧 DomainAgent</description>

  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-api</artifactId>
    </dependency>

    <!-- 契约包，自述不依赖 Spring。编解码与 Handler 只对着它编译，因此不起服务也能测 -->
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-service-spec</artifactId>
    </dependency>

    <!--
      Agent Server 那套装配（含 /v1/query 控制器）。声明成 optional：
      中控侧只做客户端调用，不该因为依赖这个模块就把一整个 Agent Server 的
      控制器与生命周期拉进自己的进程；而行内那个 Agent Server 部署件显式再依赖一次即可。
      OpenJiuwenAgentServerConfiguration 用 @ConditionalOnClass 兜住它不在时的情形。
    -->
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-service-app</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 端到端那条链路要用 TCK 验一遍：契约是隔着真实 HTTP 也得成立的 -->
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-tck</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

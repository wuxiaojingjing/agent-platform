<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 framework/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>agent-tck</artifactId>
  <name>agent-tck</name>
  <description>契约测试包：行内实现 DomainAgent / GuardrailHook 后，继承这里的抽象用例自证合规</description>

  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>asset-registry</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-api</artifactId>
    </dependency>
    <!-- ReactorLayout 只读 Maven Reactor 元数据，不依赖产品目录层级。 -->
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>intent-engine-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-runtime-api</artifactId>
    </dependency>
    <!--
      刻意只依赖明确的 API 模块，不依赖 task-orchestrator。早先为了拿 GuardrailHook 依赖过它，
      代价是把中控的自动配置带给了每一个用 TCK 的人：行内在自己的 Agent Server 里跑
      契约用例时，OrchestratorConfiguration 会被一起评估，进而要求一个 DataSource——
      只想验一下自己的 DomainAgent 合不合规，却被要求先备一套库。
      GuardrailHook 因此挪到了 com.huawei.finance.contracts.port，与 DomainAgent 并列：
      行内要实现的 SPI 本来就不该住在实现模块里。
    -->

    <!--
      compile scope 而非 test：这个模块的产出物就是给使用方继承的测试基类，
      放在 src/main 下随主 jar 发布。做成 test-jar 的话，使用方得写
      <type>test-jar</type> 才能引到，多一道谁都会忘的手续。
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 framework/runtime/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>task-orchestrator</artifactId>
  <name>task-orchestrator</name>
  <!--
    原描述是「中控」。现在「Agent 中控」指整个系统，本模块只是它的任务编排层，
    两者同名会让「中控是唯一事务边界」这句约束读不出主体。改按职责命名。
  -->
  <description>任务编排：UnifiedTask、强一致任务状态机、护栏钩子、护栏后幂等键；系统唯一事务边界</description>

  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <!--
      必须是 starter 而不是裸 flyway-core。Spring Boot 4 把自动配置按技术拆成了独立模块，
      Flyway 的那份在 spring-boot-flyway 里（由本 starter 引入）。只引 flyway-core
      的后果不是编译报错也不是启动报错，而是 `spring.flyway.*` 整段配置**静默失效**：
      应用照常启动，只是一条迁移都不跑。

      这个坑此前一直藏着：库里的表其实是中控集成测试自己 Flyway.configure() 建出来的，
      看起来一切正常，实则应用从未对着空库验证过。加 context-engine 的 V2 迁移时才暴露。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
  </dependencies>
</project>

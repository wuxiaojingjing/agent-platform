<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 framework/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>agent-observability</artifactId>
  <name>agent-observability</name>
  <description>观测：指标与标签名、决策链路 trace 记录器，记录范围为可覆盖的扩展点</description>

  <!--
    刻意不依赖业务 Agent。本模块定义自己的中性值类型（ScoredCandidate 等），
    调用方负责把领域类型映射进来。这个映射步骤不是多余的一层：它是「哪些字段
    允许离开领域对象、进入 APM」这个决定的唯一发生地，看得见才审得动。
    同时这让每个模块都能安全依赖 agent-observability 而不会成环。
  -->
  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <!--
      依赖 micrometer-tracing 而不是 opentelemetry-api：Micrometer Tracing 本身就是
      面向多种 APM 的抽象（OTEL / Brave 各有桥接）。行内若用 SkyWalking 或 Brave，
      只需换入口 mobile-banking-assistant 里的桥接实现，本模块与快路径的记录代码一行都不用改。
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!--
      测试用真的 OTEL SDK 把 span 收到内存里断言，而不是 mock Span：
      要验的是属性真的落到了导出的 span 上。mock 只能证明我们调了 tag()，
      而属性名写错、值被覆盖、span 根本没进作用域这几类问题，mock 一个都拦不住。
      OTEL 只是测试期的一个具体 APM 后端，主代码仍只依赖 micrometer-tracing 抽象。
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

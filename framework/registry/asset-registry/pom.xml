<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 framework/registry/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>asset-registry</artifactId>
  <name>asset-registry</name>
  <description>能力资产的加载、校验与只读视图。从 capability-registry 切出，好让复用意图引擎的 Agent 不被拖进 OpenSearch</description>

  <!--
    刻意不依赖 opensearch-java，也不依赖 model-openai-compatible。
    切出本模块的唯一目的就是这个：资产（AssetBundle/AssetStore/AssetLint 等）与
    检索索引（registry.index，直连 OpenSearch）此前同住一个模块，于是
    intent-fastpath / response-engine 这些只要资产的模块，都被传递依赖拖进了
    OpenSearch 客户端与向量化网关（架构草案 §4.3 第 3 行）。
    这条由 ModuleDependencyTest 钉住。
  -->
  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-api</artifactId>
    </dependency>
    <!-- 资产定位、加载与校验在本模块内聚，不借助兼容聚合壳获取传递依赖。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

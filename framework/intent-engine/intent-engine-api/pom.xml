<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 framework/intent-engine/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>intent-engine-api</artifactId>
  <name>intent-engine-api</name>
  <!--
    架构草案 §0.3 第 3 条：「意图引擎必须单独定义为一级模块，供所有 Agent 引用。」
    引用的就是本模块。

    为什么门面不能继续住在 intent-fastpath 里：那个模块编译期带 hanlp、aviator 与
    agent-core-java。门面本身只有几个接口和记录，可只要它跟实现同处一个模块，
    「依赖意图引擎」在物理上就等于「依赖一套具体实现」。已经有人在付这个代价——
    cache-redis 这个**适配器**曾为了实现一个 DecisionCache 而依赖整个 intent-fastpath。

    下面的依赖只有三条，且是有意封顶的：契约、公共类型、承诺面标注。
    多一条就意味着某个依赖方要为用门面而背上不相干的东西，
    这条由 ModuleDependencyTest#intentEngineApiIsDependableAlone 钉住。
  -->
  <description>意图引擎门面：IntentEngine 与其入参出参、出口缓存 SPI。其他 Agent 引这个，不引具体实现</description>

  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-api</artifactId>
    </dependency>
  </dependencies>
</project>

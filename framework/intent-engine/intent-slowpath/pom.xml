<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- 移进 framework/intent-engine/ 一层后父 pom 不再是默认的 ../pom.xml -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>intent-slowpath</artifactId>
  <name>intent-slowpath</name>
  <description>慢路径：把一句复合诉求规划成若干步能力调用。与 intent-fastpath 平级，只规划不执行</description>

  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-api</artifactId>
    </dependency>
    <!--
      刻意没有 capability-registry：本模块主代码与测试都不引用 com.huawei.finance.registry.* 里的
      任何类型（拆资产模块时逐一查过）。留着它只会让 OpenSearch 客户端凭传递依赖进到
      慢路径的 classpath 上。
    -->
    <!--
      只为拿 ModelGatewayClientFactory：慢路径的模型调用必须落到本行那条带预算与熔断的通道，
      而把它注册进 OJ 的正是适配层。依赖方向是「策略依赖适配」，反过来则不成立——
      适配层不该知道慢路径存在。
    -->
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>openjiuwen-adapter</artifactId>
    </dependency>
    <!--
      慢路径只规划不执行（ADR-004）：工具是 ProposalTool。
      不得再依赖 task-orchestrator——可执行 Tool 会把「只规划」变回第二条执行路径。
    -->

    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-core-java</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

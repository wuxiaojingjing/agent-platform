  {
    "id": "task-switch-accept-resume-execute",
    "category": "任务切换-接受并恢复",
    "steps": [
      {
        "query": "查一下余额",
        "expect": {
          "decision": "EXECUTE_CAPABILITY",
          "phase": "FINAL",
          "candidate": "cap.account.balance.query",
          "cardComponents": ["RESULT_SUMMARY"],
          "textContains": ["可用余额"]
        }
      },
      {
        "query": "用第二张卡给张三转账",
        "expect": {
          "decision": "CLARIFY",
          "phase": "CLARIFY",
          "reasonCode": "MISSING_SLOT",
          "candidate": "cap.transfer",
          "taskIdPresent": true,
          "captureTaskIdAs": "suspendedTransfer"
        }
      },
      {
        "query": "先看看基金产品C",
        "expect": {
          "decision": "CLARIFY",
          "phase": "SWITCH_REVIEW",
          "cardComponents": ["REVIEW_SUMMARY"],
          "responseActions": ["SWITCH_ACCEPT", "SWITCH_REJECT"],
          "textContains": ["切换"]
        }
      },
      {
        "actionFromPrevious": "SWITCH_ACCEPT",
        "expect": {
          "phase": "FINAL",
          "template": "tpl.product.result",
          "cardComponents": ["RESULT_SUMMARY"],
          "responseActions": ["RESUME_SUSPENDED"],
          "taskIdDiffersCapture": "suspendedTransfer",
          "captureTaskIdAs": "fundTask",
          "textContains": ["基金产品C"]
        }
      },
      {
        "actionFromPrevious": "RESUME_SUSPENDED",
        "actionRefCaptureFromPrevious": "suspendedTransfer",
        "expect": {
          "decision": "RESUME_TASK",
          "taskIdEqualsCapture": "suspendedTransfer",
          "textContains": ["金额"]
        }
      },
      {
        "query": "1000",
        "expect": {
          "decision": "RESUME_TASK",
          "phase": "CONFIRM",
          "cardComponents": ["REVIEW_SUMMARY", "RISK_NOTICE"],
          "responseActions": ["CONFIRM", "CANCEL"],
          "actionRefsTaskId": ["CONFIRM", "CANCEL"],
          "taskIdEqualsCapture": "suspendedTransfer",
          "slotValues": {"accountOrdinal": 2, "payee": "张三", "amount": "1000"}
        }
      },
      {
        "actionFromPrevious": "CONFIRM",
        "expect": {
          "decision": "RESUME_TASK",
          "phase": "FINAL",
          "template": "tpl.transfer.result",
          "cardComponents": ["RESULT_SUMMARY"],
          "taskIdEqualsCapture": "suspendedTransfer",
          "textContains": ["张三", "1000"]
        }
      }
    ]
  },

  {
    "id": "task-switch-reject",
    "category": "任务切换",
    "steps": [
      {
        "query": "换卡",
        "expect": {
          "decision": "CLARIFY",
          "phase": "CLARIFY"
        }
      },
      {
        "query": "先查信用卡账单",

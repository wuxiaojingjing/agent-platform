<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huawei.finance</groupId>
    <artifactId>agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- agents/account：父 pom 在仓库根 -->
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>account</artifactId>
  <name>account</name>
  <description>账户域节点：指代解析 + 叶子执行器。见架构草案 v0.4 阶段 1.5 / 3a</description>

  <!--
    刻意不依赖入口 mobile-banking-assistant、context-engine、task-orchestrator：方向是「入口认端口，域实现端口」。
    反过来一旦成立（域依赖入口），域内语义就又能顺着依赖回流到入口，
    §2.3 那条禁令就只剩注释效力了。这条由 ModuleDependencyTest 钉住。
  -->
  <dependencies>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>stability-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>task-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-web</artifactId></dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>a2a-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.huawei.finance</groupId>
      <artifactId>agent-tck</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
